{
  "version": 2,
  "buildCommand": "react-scripts build",
  "outputDirectory": "build",
  "env": {
    "CI": "false",
    "GENERATE_SOURCEMAP": "false"
  },
  "framework": null,
  "routes": [
    {
      "src": "/Malith_Madushan_Resume\\.pdf",
      "headers": {
        "Content-Type": "application/pdf",
        "Content-Disposition": "attachment; filename=\"Malith_Madushan_CV.pdf\""
      },
      "continue": true
    },
    {
      "src": "/Malith_Madushan_CV\\.pdf",
      "headers": {
        "Content-Type": "application/pdf",
        "Content-Disposition": "attachment; filename=\"Malith_Madushan_CV.pdf\""
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
