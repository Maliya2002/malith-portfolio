{
  "version": 2,
  "buildCommand": "react-scripts build",
  "outputDirectory": "build",
  "env": {
    "CI": "false",
    "GENERATE_SOURCEMAP": "false"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "headers": [
        {
          "value": "application/pdf",
          "key": "Content-Type"
        },
        {
          "value": "attachment; filename=\"Malith_Madushan_CV.pdf\"",
          "key": "Content-Disposition"
        }
      ],
      "source": "/Malith_Madushan_Resume.pdf"
    },
    {
      "headers": [
        {
          "value": "application/pdf",
          "key": "Content-Type"
        },
        {
          "value": "attachment; filename=\"Malith_Madushan_CV.pdf\"",
          "key": "Content-Disposition"
        }
      ],
      "source": "/Malith_Madushan_CV.pdf"
    }
  ]
}
